function c { cd ~/code/$1; }
function h { cd ~/$1; }

alias ..='cd ..'
alias ls='ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias pd='gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"'
alias pl='gsettings set org.gnome.desktop.interface color-scheme "prefer-light"'
alias vim=nvim
alias vi=nvim

# Git
alias gl='git pull'
alias gp='git push'
alias gc='git commit -am'
alias gs='git status --short'
alias gb='git branch'
alias gba='git branch -a'
alias gd='git diff'
alias gm='git merge'
alias gg='git log --graph --oneline --color'
alias gaa='git add .; git commit --amend'
alias gfr='git fetch --all && git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)'

# ─── Modern CLI replacements ──────────────────────────────────
# Ubuntu ships fd as fdfind and bat as batcat (binary name clashes).
command -v fdfind  >/dev/null 2>&1 && alias fd='fdfind'
command -v batcat  >/dev/null 2>&1 && alias bat='batcat'
command -v eza     >/dev/null 2>&1 && {
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2'
}
command -v ncdu    >/dev/null 2>&1 && alias du-i='ncdu'
command -v btop    >/dev/null 2>&1 && alias top='btop'
