[user]
	name = Daniel Stockton
	email = me@danielstockton.com
	# Default is the MacBook's key. Ubuntu overrides this in ~/.gitconfig.local
	# because it has no ed25519 key.
	signingkey = ~/.ssh/id_ed25519.pub
[color]
	ui = true
[web]
	browser = google-chrome
[core]
	# ~ resolves on both macOS and Linux; the old absolute path
	# (/home/daniel/...) was wrong on both machines.
	excludesfile = ~/.gitignore_global
[gpg]
	format = ssh
[commit]
	gpgsign = true
[alias]
	pushall = !git push origin main && git push gitlab main
# Per-machine overrides (signing key, allowed signers). Untracked, and a
# missing file is silently ignored by git - so this is safe on a fresh clone.
[include]
	path = ~/.gitconfig.local
